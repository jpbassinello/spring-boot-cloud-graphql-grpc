# Copy to .env on the deploy host and fill in. NEVER commit the real .env — it is gitignored.
# The deploy job in .github/workflows/publish.yml refuses to run if any of the required keys
# below is missing or blank, rather than silently starting the stack with empty secrets.

# Hostnames (DNS A records → this host's IP)
GATEWAY_HOSTNAME=api.example.com
KEYCLOAK_HOSTNAME=auth.example.com
CONSUL_HOSTNAME=consul.example.com
GRAFANA_HOSTNAME=grafana.example.com

# Contact address Let's Encrypt uses for expiry notices
ACME_EMAIL=infra@example.com

# Container image registry / namespace. Must match .github/workflows/publish.yml.
REGISTRY=ghcr.io/jpbassinello

# Basic auth for the admin dashboards (Consul, Grafana)
# Generate with: htpasswd -nB admin
# IMPORTANT: escape dollar signs by doubling them ($ -> $$)
# Example for admin:admin -> admin:$$2y$$05$$...
ADMIN_BASIC_AUTH=admin:$$2y$$05$$your-bcrypt-hash-here

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Keycloak
KEYCLOAK_ADMIN=keycloak
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password

# Redis
REDIS_PASSWORD=change-me-strong-password

# Written by the deploy job on every deploy; pins this host to one commit's images so a manual
# `docker compose up` on the host uses the same set. Leave it out when bootstrapping by hand.
#IMAGE_TAG=latest
